{
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["/^font-size$/", "/^border-radius$/", "/^box-shadow$/", "color", "background-color", "border-color"],
      {
        "ignoreValues": ["inherit", "initial", "unset", "none", "currentColor", "transparent", "0", "inset"],
        "severity": "error"
      }
    ]
  }
}
